# Raw data is rebuilt by scripts/download_data.py (see data/catalog.yaml); never commit it.
data/raw/

# Spark outputs (Parquet, intermediate results)
data/processed/

# Local Spark files
spark-warehouse/
metastore_db/
derby.log

# Python / Jupyter
__pycache__/
.ipynb_checkpoints/
.venv/

# Secrets (SENAMHI API key)
.env

# macOS
.DS_Store

# LaTeX report: only the source is versioned (PDF and build files stay local)
docs/report/build/
docs/report/**/*.pdf
docs/report/**/*.aux
docs/report/**/*.bbl
docs/report/**/*.bcf
docs/report/**/*.blg
docs/report/**/*.fdb_latexmk
docs/report/**/*.fls
docs/report/**/*.log
docs/report/**/*.out
docs/report/**/*.run.xml
docs/report/**/*.synctex.gz
docs/report/**/*.toc
